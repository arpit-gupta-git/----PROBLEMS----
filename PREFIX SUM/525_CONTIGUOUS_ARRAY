class Solution:
    def findMaxLength(self, nums: List[int]) -> int:
        total =  0
        max1 = float('-inf')
        prefix_sum = {0 : -1}
        for i in range(len(nums)):
            if nums[i] == 0 :
                nums[i] -= 1 
        for i in range(len(nums)):
            total  += nums[i]
            if total in prefix_sum:
                max1 = max(max1, i - prefix_sum[total] )
            if total not in prefix_sum:
                prefix_sum[total] = i 
        return 0 if max1 == float('-inf') else max1
            
